from math import factorial

"""
Euler's Number Calculator

This program approximates Euler's number (e) using the infinite series:
e = 1 + 1/1! + 1/2! + 1/3! + ... + 1/n!

The more iterations (higher n) you use, the more accurate the approximation becomes.
"""

# Get user input for the number of iterations
n = int(input("Enter the number of iterations: "))

# Print separator line
print("-" * 112)

# Initialize the approximation with the first term (1)
euler_number = 1

# Calculate each term of the series and add it to the approximation
for i in range(1, n + 1):
    euler_number += (1 / factorial(i))
    # Print the current approximation after each iteration
    print(f"After {i} iteration - Euler number approximation: {euler_number}")

# Print final results
print("-" * 112)
print(f"After {n:_} iterations: Euler number approximation is: {euler_number}")
print("-" * 112)
